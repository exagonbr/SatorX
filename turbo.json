{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:init": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:migrate:dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "server": {
      "cache": false,
      "persistent": true
    },
    "suite": {
      "cache": false
    }
  }
}
