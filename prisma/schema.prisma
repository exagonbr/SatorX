// PostgreSQL (Vercel / local). DATABASE_URL no .env ou nas env vars do deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TdLearning {
  id              Int     @id @default(autoincrement())
  createdAt       String  @map("created_at")
  tdError         Float?  @map("td_error")
  vBefore         Float?  @map("v_before")
  vAfter          Float?  @map("v_after")
  tdTarget        Float?  @map("td_target")
  terminal        Int     @map("terminal")
  outcomeForMover Int     @map("outcome_for_mover")
  updates         Int     @map("updates")

  @@index([createdAt], map: "idx_td_learning_created")
  @@map("td_learning")
}

model NnWeightsSnapshot {
  id        Int    @id @default(autoincrement())
  createdAt String @map("created_at")
  updates   Int    @map("updates")
  payload   String @map("payload")

  @@index([updates], map: "idx_nn_snapshots_updates")
  @@map("nn_weights_snapshots")
}

/// Partida salva (replays) — fonte para o buffer de posições.
model GameReplay {
  id        String @id
  createdAt String @map("created_at")
  result    String
  fen       String?
  pgn       String?
  movesJson String @map("moves_json")
  metaJson  String @map("meta_json")

  bufferRows ReplayBufferRow[]

  @@index([createdAt], map: "idx_game_replays_created")
  @@map("game_replays")
}

/// Posições derivadas dos replays (amostragem para train-buffer).
model ReplayBufferRow {
  id        Int    @id @default(autoincrement())
  replayId  String @map("replay_id")
  createdAt String @map("created_at")
  result    String
  ply       Int
  fen       String

  replay GameReplay @relation(fields: [replayId], references: [id], onDelete: Cascade)

  @@index([replayId], map: "idx_replay_buffer_replay_id")
  @@map("replay_buffer_rows")
}

/// Histórico de partidas multijogador (lobby) para ranking na UI.
model LobbyRanking {
  id          String  @id @default(cuid())
  lobbyId     String  @map("lobby_id")
  whiteName   String? @map("white_name")
  blackName   String? @map("black_name")
  winner      String
  reasonCode  String  @map("reason_code")
  reasonLabel String  @map("reason_label")
  scoreWhite  Float   @map("score_white")
  scoreBlack  Float   @map("score_black")
  durationSec Int     @map("duration_sec")
  startedAt   String  @map("started_at")
  endedAt     String  @map("ended_at")
  recordedAt  String  @map("recorded_at")

  @@index([lobbyId], map: "idx_lobby_ranking_lobby_id")
  @@index([endedAt], map: "idx_lobby_ranking_ended")
  @@map("lobby_rankings")
}

/// Registro de todas as partidas (local, vs IA e online).
model MatchLog {
  id          String  @id @default(cuid())
  sourceKey   String  @unique @map("source_key")
  mode        String
  ui          String?
  whiteName   String? @map("white_name")
  blackName   String? @map("black_name")
  opponent    String?
  location    String?
  winner      String
  reasonCode  String  @map("reason_code")
  reasonLabel String? @map("reason_label")
  scoreWhite  Float   @map("score_white")
  scoreBlack  Float   @map("score_black")
  startedAt   String  @map("started_at")
  endedAt     String  @map("ended_at")
  recordedAt  String  @map("recorded_at")
  lobbyId     String? @map("lobby_id")
  sessionId   String? @map("session_id")

  @@index([endedAt], map: "idx_match_logs_ended")
  @@index([recordedAt], map: "idx_match_logs_recorded")
  @@map("match_logs")
}

/// Estado em curso do lobby (multijogador) — necessário em Vercel (sem memória partilhada).
model LobbySession {
  id        String   @id
  payload   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedAt], map: "idx_lobby_sessions_updated")
  @@map("lobby_sessions")
}

/// Partida ao vivo partilhada entre vistas 2D e 3D.
model LiveGameSession {
  id        String   @id
  payload   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedAt], map: "idx_live_game_sessions_updated")
  @@map("live_game_sessions")
}

/// Log lance-a-lance para treino, seeds e estatísticas.
model GameMoveLog {
  id        Int    @id @default(autoincrement())
  sessionId String @map("session_id")
  ply       Int
  san       String
  fenBefore String @map("fen_before")
  fenAfter  String @map("fen_after")
  ui        String
  source    String
  createdAt String @map("created_at")

  @@index([sessionId], map: "idx_game_move_logs_session")
  @@index([createdAt], map: "idx_game_move_logs_created")
  @@map("game_move_logs")
}

/// Frequência de lances por posição (livro SatorX + ingestão Lichess).
model MoveStat {
  fenCore   String @map("fen_core")
  san       String
  plays     Int    @default(0)
  whiteWins Int    @default(0) @map("white_wins")
  blackWins Int    @default(0) @map("black_wins")
  draws     Int    @default(0)
  lastAt    String @map("last_at")
  sources   String @default("satorx")

  @@id([fenCore, san])
  @@map("move_stats")
}
